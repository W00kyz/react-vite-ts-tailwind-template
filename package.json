{
  "name": "wookyz",
  "type": "module",
  "version": "1.0.0",
  "description": "Starter template for Vite with React, TypeScript and Tailwind CSS",
  "author": "Marcos Antônio <marcoscardoso.programmer@gmail.com>",
  "license": "MIT",
  "browserslist": [
    ">0.2%",
    "not dead",
    "not IE 11"
  ],
  "engines": {
    "node": ">=18",
    "yarn": ">=1.22.5"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "i18n:lint": "i18next-cli lint",
    "i18n:sync": "node scripts/sync-i18n-namespaces.js",
    "i18n:extract": "i18next-cli extract",
    "i18n": "npm run i18n:extract && npm run i18n:sync && i18next-cli status"
  },
  "dependencies": {
    "@heroicons/react": "2.1.5",
    "@reduxjs/toolkit": "2.9.1",
    "@tanstack/react-query": "5.90.5",
    "i18next": "25.6.0",
    "i18next-browser-languagedetector": "8.2.0",
    "i18next-http-backend": "3.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.65.0",
    "react-i18next": "16.1.0",
    "react-redux": "9.2.0",
    "react-router": "7.9.4",
    "vite-tsconfig-paths": "5.1.4"
  },
  "devDependencies": {
    "@commitlint/cli": "19.5.0",
    "@eslint/js": "9.13.0",
    "@tailwindcss/forms": "0.5.9",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "5.0.4",
    "autoprefixer": "10.4.20",
    "eslint": "9.38.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-refresh": "0.4.14",
    "i18next-cli": "1.11.5",
    "lint-staged": "15.2.10",
    "msw": "2.11.5",
    "postcss": "8.4.47",
    "prettier": "3.3.3",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "typescript-eslint": "8.10.0",
    "vite": "7.1.10",
    "vitest": "3.2.4"
  }
}
